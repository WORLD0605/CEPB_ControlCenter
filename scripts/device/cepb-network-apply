#!/bin/sh

set -eu

CONFIG_FILE=${2:-/etc/cepb/network.conf}
MANAGED_ROUTE_PROTO=186
INTERFACE_WAIT_SECONDS=${CEPB_NETWORK_INTERFACE_WAIT_SECONDS:-30}
APPLY_STATUS_FILE=${CEPB_NETWORK_STATUS_FILE:-/run/cepb-network-apply.status}

fail()
{
    echo "ERROR: $*" >&2
    exit 1
}

valid_ipv4()
{
    awk -v ip="$1" 'BEGIN {
        n = split(ip, a, ".")
        if (n != 4) exit 1
        for (i = 1; i <= 4; ++i) {
            if (a[i] !~ /^[0-9]+$/ || a[i] < 0 || a[i] > 255) exit 1
        }
    }'
}

valid_prefix()
{
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 0 ] && [ "$1" -le 32 ]
}

valid_interface()
{
    case "$1" in
        eth0|eth1|eth2|eth3|eth4|eth5|eth6|eth7) return 0 ;;
        *) return 1 ;;
    esac
}

configured_interfaces()
{
    awk -F'|' '
        $1 == "INTERFACE" { print $2 }
        $1 == "ROUTE" { print $4 }
    ' "$1"
}

wait_for_interfaces()
{
    file=$1
    waited=0

    while :; do
        missing=
        for name in $(configured_interfaces "$file"); do
            valid_interface "$name" || continue
            if ! ip link show "$name" >/dev/null 2>&1; then
                case " $missing " in
                    *" $name "*) ;;
                    *) missing="${missing}${missing:+ }$name" ;;
                esac
            fi
        done

        [ -n "$missing" ] || {
            [ "$waited" -eq 0 ] || echo "interfaces became ready after ${waited}s"
            return 0
        }
        [ "$waited" -lt "$INTERFACE_WAIT_SECONDS" ] \
            || fail "interfaces did not appear within ${INTERFACE_WAIT_SECONDS}s: $missing"

        [ "$waited" -ne 0 ] || echo "waiting for interfaces: $missing"
        sleep 1
        waited=$((waited + 1))
    done
}

check_config()
{
    file=$1
    [ -r "$file" ] || fail "configuration is not readable: $file"

    version_seen=0
    interface_count=0
    line_no=0
    while IFS='|' read -r kind field1 field2 field3 field4 extra || [ -n "${kind}${field1}${field2}${field3}${field4}${extra}" ]; do
        line_no=$((line_no + 1))
        case "$kind" in
            ''|'#'*) continue ;;
            VERSION)
                [ "$version_seen" -eq 0 ] || fail "line $line_no: duplicate VERSION"
                [ "$field1" = "1" ] || fail "line $line_no: unsupported VERSION $field1"
                [ -z "${field2}${field3}${field4}${extra}" ] || fail "line $line_no: too many fields"
                version_seen=1
                ;;
            INTERFACE)
                valid_interface "$field1" || fail "line $line_no: invalid interface $field1"
                valid_ipv4 "$field2" || fail "line $line_no: invalid IPv4 address $field2"
                valid_prefix "$field3" || fail "line $line_no: invalid prefix $field3"
                [ -z "${field4}${extra}" ] || fail "line $line_no: too many fields"
                ip link show "$field1" >/dev/null 2>&1 || fail "line $line_no: interface $field1 does not exist"
                interface_count=$((interface_count + 1))
                ;;
            ROUTE)
                destination=$field1
                gateway=$field2
                device=$field3
                metric=$field4
                network=${destination%/*}
                prefix=${destination#*/}
                [ "$network" != "$destination" ] || fail "line $line_no: route destination must use CIDR"
                valid_ipv4 "$network" || fail "line $line_no: invalid route destination $destination"
                valid_prefix "$prefix" || fail "line $line_no: invalid route prefix $prefix"
                valid_ipv4 "$gateway" || fail "line $line_no: invalid gateway $gateway"
                valid_interface "$device" || fail "line $line_no: invalid route interface $device"
                case "$metric" in ''|*[!0-9]*) fail "line $line_no: invalid metric $metric" ;; esac
                [ -z "$extra" ] || fail "line $line_no: too many fields"
                ip link show "$device" >/dev/null 2>&1 || fail "line $line_no: interface $device does not exist"
                ;;
            *) fail "line $line_no: unknown record type $kind" ;;
        esac
    done < "$file"

    [ "$version_seen" -eq 1 ] || fail "VERSION record is missing"
    [ "$interface_count" -gt 0 ] || fail "no INTERFACE records"
    echo "configuration check passed: $file"
}

apply_config()
{
    file=$1
    wait_for_interfaces "$file"
    check_config "$file"

    while IFS='|' read -r kind name address prefix unused extra || [ -n "${kind}${name}${address}${prefix}${unused}${extra}" ]; do
        [ "$kind" = "INTERFACE" ] || continue
        ip link set "$name" up
        ip -4 addr flush dev "$name" scope global
        ip addr add "$address/$prefix" dev "$name"
        echo "applied interface $name $address/$prefix"
    done < "$file"

    ip -4 route flush proto "$MANAGED_ROUTE_PROTO" 2>/dev/null || true
    while IFS='|' read -r kind destination gateway device metric extra || [ -n "${kind}${destination}${gateway}${device}${metric}${extra}" ]; do
        [ "$kind" = "ROUTE" ] || continue
        ip route replace "$destination" via "$gateway" dev "$device" metric "$metric" proto "$MANAGED_ROUTE_PROTO"
        echo "applied route $destination via $gateway dev $device metric $metric"
    done < "$file"
}

write_apply_status()
{
    write_state=$1
    write_exit_code=$2
    write_output_file=${3:-}
    write_status_tmp="${APPLY_STATUS_FILE}.$$"

    {
        echo "STATE|$write_state"
        echo "EXIT_CODE|$write_exit_code"
        [ -z "$write_output_file" ] || cat "$write_output_file"
    } > "$write_status_tmp"
    mv "$write_status_tmp" "$APPLY_STATUS_FILE"
}

apply_with_status()
{
    apply_file=$1
    apply_output_file="${APPLY_STATUS_FILE}.output.$$"
    write_apply_status running 0

    if (apply_config "$apply_file") > "$apply_output_file" 2>&1; then
        apply_exit_code=0
        apply_state=success
    else
        apply_exit_code=$?
        apply_state=failed
    fi

    write_apply_status "$apply_state" "$apply_exit_code" "$apply_output_file"
    cat "$apply_output_file"
    rm -f "$apply_output_file"
    return "$apply_exit_code"
}

show_status()
{
    ip -br link show
    echo "--- IPv4 addresses ---"
    ip -br -4 addr show
    echo "--- IPv4 routes ---"
    ip -4 route show table main
}

case "${1:-}" in
    check) check_config "$CONFIG_FILE" ;;
    apply) apply_with_status "$CONFIG_FILE" ;;
    show) show_status ;;
    *)
        echo "Usage: $0 {check|apply|show} [config-file]" >&2
        exit 2
        ;;
esac
