[Unit]
Description=CEP DLT645
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/cepgateway/app/cepdlt645
Environment="LD_LIBRARY_PATH=/home/cepgateway/app/lib/:/home/cepgateway/lib/"
ExecStart=/home/cepgateway/app/cepdlt645/bin/cepdlt645 -debug
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=5
KillMode=control-group
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
