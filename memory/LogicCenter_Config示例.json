{
    "computation_points": [
        {
            "DeviceId": "999",
            "dataRef": "PROT.SlrInvMMXU.1.TotalP",
            "formula": "{1}+{2}",
            "description": "虚拟并网点总有功，由两个南向设备有功相加得到",
            "drop_operands": true,
            "operands": [
                {
                    "DeviceId": "11",
                    "dataRef": "PROT.SlrInvMMXU.1.ActPwr"
                },
                {
                    "DeviceId": "12",
                    "dataRef": "PROT.SlrInvMMXU.1.ActPwr"
                }
            ]
        },
        {
            "DeviceId": "999",
            "dataRef": "PROT.SlrInvMMXU.1.TotalQ",
            "formula": "{1}+{2}",
            "description": "虚拟并网点总无功，由两个南向设备无功相加得到",
            "drop_operands": true,
            "operands": [
                {
                    "DeviceId": "11",
                    "dataRef": "PROT.SlrInvMMXU.1.ReactPwr"
                },
                {
                    "DeviceId": "12",
                    "dataRef": "PROT.SlrInvMMXU.1.ReactPwr"
                }
            ]
        },
        {
            "DeviceId": "999",
            "dataRef": "PROT.SlrInvMMXU.1.Cos",
            "formula": "({1})/sqrt(({1})*({1})+({2})*({2}))",
            "description": "虚拟并网点功率因数",
            "drop_operands": false,
            "operands": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvMMXU.1.TotalP"
                },
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvMMXU.1.TotalQ"
                }
            ]
        },
        {
            "DeviceId": "999",
            "dataRef": "PROT.SlrInvAlmGGIO.1.AnyFault",
            "formula": "1-(1-{1})*(1-{2})*(1-{3})",
            "description": "多个遥信告警做或运算，任一告警为1则输出1",
            "drop_operands": true,
            "operands": [
                {
                    "DeviceId": "11",
                    "dataRef": "PROT.SlrInvAlmGGIO.1.Fault1"
                },
                {
                    "DeviceId": "11",
                    "dataRef": "PROT.SlrInvAlmGGIO.1.Fault2"
                },
                {
                    "DeviceId": "12",
                    "dataRef": "PROT.SlrInvAlmGGIO.1.Fault1"
                }
            ]
        },
        {
            "DeviceId": "999",
            "dataRef": "PROT.SlrInvMMXU.1.ActPwrFdB",
            "formula": "{1}",
            "description": "有功设定反馈，保留源点转发并额外生成反馈点",
            "drop_operands": false,
            "operands": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvMMXU.1.ActPwrReg"
                }
            ]
        }
    ],
    "control_rules": [
        {
            "match": {
                "DeviceId": "999",
                "dataRef": "PROT.SlrInvCtlGGIO.1.PTGTotalP_Ctrl",
                "CtrlType": "1"
            },
            "targets": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvCtlGGIO.1.TotalP_Ctrl",
                    "expr": "{x} * 2050",
                    "targetType": "ctrlcmd"
                },
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvMMXU.1.PTGTotalP",
                    "expr": "{x}",
                    "targetType": "data_write"
                }
            ]
        },
        {
            "match": {
                "DeviceId": "999",
                "dataRef": "PROT.SlrInvCtlGGIO.1.ReactPwrReg",
                "CtrlType": "1"
            },
            "targets": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvCtlGGIO.1.TotalQ_Ctrl",
                    "expr": "{x}",
                    "target_type": "ctrlcmd"
                }
            ]
        },
        {
            "match": {
                "DeviceId": "999",
                "dataRef": "PROT.SlrInvCtlGGIO.1.AGC_enable_Ctrl",
                "CtrlType": "1"
            },
            "targets": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvAlmGGIO.1.AGC_enable_Ctrl",
                    "expr": "1 - {x}",
                    "targetType": "ctrlcmd"
                },
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvAlmGGIO.1.AGC_enable",
                    "expr": "{x}",
                    "targetType": "data_write"
                }
            ]
        },
        {
            "match": {
                "DeviceId": "999",
                "dataRef": "PROT.SlrInvCtlGGIO.1.TotalPByRt_Ctrl",
                "CtrlType": "1"
            },
            "targets": [
                {
                    "DeviceId": "999",
                    "dataRef": "PROT.SlrInvCtlGGIO.1.TotalP_Ctrl",
                    "expr": "{x} + {rt:999#PROT.SlrInvMMXU.1.TotalP}",
                    "targetType": "ctrlcmd"
                }
            ]
        },
        {
            "match": {
                "DeviceId": "SWITCH66666666",
                "dataRef": "PROT.SlrInvCtlGGIO.1.Cbr_Pos_ctlVal",
                "CtrlType": "1"
            },
            "targets": [
                {
                    "DeviceId": "SWITCH55555555",
                    "dataRef": "PROT.SlrInvCtlGGIO.1.620_Cbr_Pos_ctlVal",
                    "expr": "{x}",
                    "targetType": "ctrlcmd"
                }
            ]
        }
    ],
